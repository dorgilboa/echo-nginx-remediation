{
  "name": "echo-nginx-remediation (debian bookworm)",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "username": "vscode", "userUid": "1000", "userGid": "1000" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash scripts/fetch-nginx-source.sh && bash scripts/versions.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker", "ms-python.python", "golang.go", "ms-vscode.makefile-tools"]
    }
  }
}

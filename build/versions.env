# Pins for the nginx source. Read by build/scripts/get-sources.sh (and later the Dockerfile/Makefile).
# NGINX_VERSION can be overridden from the environment, but build/SHA256SUMS must then
# contain a line for that exact tarball or the build fails.
NGINX_VERSION="${NGINX_VERSION:-1.25.5}"
NGINX_BASE_URL="https://nginx.org/download"

# Public key that signed the release (Roman Arutyunyan, listed at https://nginx.org/en/pgp_keys.html).
# The fingerprint is the trust anchor: the script refuses any other signer.
NGINX_SIGNING_KEY_FILE="keys/arut.key"
NGINX_SIGNING_KEY_FPR="43387825DDB1BB97EC36BA5D007C8D7C15D87369"
